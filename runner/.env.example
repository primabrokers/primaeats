# Local runner configuration. Copy to `.env` (gitignored).
#
# This file holds ONLY cloud/runtime keys. Portal credentials are NEVER here —
# they live in Windows Credential Manager (see setup-credentials.ts).

# Supabase project URL (e.g. https://xxxx.supabase.co)
SUPABASE_URL=

# Runner SERVICE-ROLE key (bypasses RLS; can claim/update jobs + insert audit rows).
# Treat as a secret. Never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for the computer-use loop.
ANTHROPIC_API_KEY=

# Optional overrides
# ANTHROPIC_MODEL=claude-sonnet-4-6
# POLL_INTERVAL_MS=5000
# MAX_ITERATIONS=40
# RUNNER_ID=office-pc-1
